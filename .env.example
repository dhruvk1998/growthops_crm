# Server-only. Never commit real values. No VITE_* variables required.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Set the four variables above securely in Vercel Project Settings > Environment Variables.
# Vercel Cron sends CRON_SECRET as a bearer token to the protected GET endpoint.
# Never put private values in vercel.json or expose them to untrusted previews.
